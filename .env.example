# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Wallpaper SaaS

# MongoDB
# Use the Atlas connection string for your cluster.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=wallpaper_saas

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXTAUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Bunny Storage
# BUNNY_STORAGE_ZONE must be the Storage Zone name used by the Storage API.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com

# Bunny CDN
BUNNY_CDN_HOSTNAME=
BUNNY_PULL_ZONE_ID=
# Security key from the Pull Zone's token authentication settings.
BUNNY_CDN_TOKEN_KEY=

# Image processing
MAX_UPLOAD_SIZE_MB=25
IMAGE_QUALITY_WEBP=90
IMAGE_QUALITY_AVIF=85

# Local/integration tests
TEST_BASE_URL=http://localhost:3000
